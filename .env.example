# Database (PostgreSQL / Supabase)
# For Supabase, use the Transaction Pooler (port 6543) for DATABASE_URL and Session / Direct (port 5432) for DIRECT_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication Credentials (Demo / Admin)
AUTH_USERNAME=jolly
AUTH_PASSWORD=Abc@123

# Also supporting USERNAME & PASSWORD as per spec
USERNAME=jolly
PASSWORD=Abc@123

# Auth secret & session
AUTH_SECRET="jolly_grand_luxury_secret_jwt_key_2026_production"
NEXTAUTH_SECRET="jolly_grand_luxury_secret_jwt_key_2026_production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
